<header>
  <h1>Medical LLM & VLM Benchmarks</h1>
  <button class="menu-toggle" aria-label="Toggle navigation menu">
    <div class="hamburger">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </button>
  <nav>
    <a href={import.meta.env.BASE_URL}>Home</a>
    <a href={import.meta.env.BASE_URL + 'docs/llm-benchmarks/'}>LLM Benchmarks</a>
    <a href={import.meta.env.BASE_URL + 'docs/vlm-benchmarks/'}>VLM Benchmarks</a>
    <a href={import.meta.env.BASE_URL + 'docs/cost-analysis/'}>Cost Analysis</a>
  </nav>
</header>

<script>
  // Mobile menu toggle functionality
document.addEventListener('DOMContentLoaded', function() {
  const menuToggle = document.querySelector('.menu-toggle');
  const nav = document.querySelector('nav');

  if (menuToggle && nav) {
    menuToggle.addEventListener('click', function() {
      nav.classList.toggle('active');
    });

    // Close menu when clicking on a link
    const navLinks = document.querySelectorAll('nav a');
    navLinks.forEach(link => {
      link.addEventListener('click', () => {
        nav.classList.remove('active');
      });
    });
  }
});
</script>
