---
import '../styles/global.css';

import Header from './Header.astro';

export interface Props {
  title?: string;
}

const { title = 'Medical LLM Research' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} - Medical LLM Research</title>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
</body>
</html>
