---
import Layout from '../components/Layout.astro';
import type { MarkdownInstance } from 'astro';

// Type the glob result properly
const mdFiles = import.meta.glob<MarkdownInstance<Record<string, any>>>('../pages/docs/latest.md', { eager: true });
const latestMd = Object.values(mdFiles)[0];
const { Content, frontmatter } = latestMd;
---

<Layout>
  <h1>{frontmatter.title}</h1>
  <Content />
</Layout>
